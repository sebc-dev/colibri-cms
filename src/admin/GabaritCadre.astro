---
/**
 * Le cadre commun aux écrans d'administration, rendu par le serveur (ticket
 * 03, openspec/changes/005-mise-en-page-administration/tickets/
 * 03-cadre-avec-l-ecran.md ; complété par le ticket 04,
 * openspec/changes/005-mise-en-page-administration/tickets/
 * 04-repli-et-tiroir.md, design.md §D3/§D8).
 *
 * Enveloppe `Gabarit.astro` (ticket 01) : le logo, le menu des cinq
 * rubriques (`MenuRubriques.astro`) et le contenu de l'écran (`<slot/>`)
 * arrivent tous dans la même réponse HTTP, sans attendre l'exécution d'un
 * script (SC-03b).
 *
 * Ce ticket ajoute, à ce même rendu serveur :
 * - la **barre du haut** (écran étroit seulement, sous `md` — 768 px) :
 *   bouton de menu, logo (SC-04d) ;
 * - le **bouton de repli** de la barre latérale (écran large, SC-04a,
 *   SC-04b) ;
 * - le **tiroir** : un `<dialog>` natif portant une seconde instance de
 *   `MenuRubriques.astro`, fond voilé par le token `--overlay`
 *   (`admin.css`, via la variante Tailwind `backdrop:`) (SC-04d, SC-04e).
 *
 * Tout le comportement (repli persistant, ouverture/fermeture du tiroir)
 * tient dans `./cadre.ts`, chargé par le `<script>` de module ci-dessous —
 * jamais un script en ligne, aucune directive `client:*` (`I4`, `I12`,
 * ADR-0006). Deux instances du menu existent dans le document (barre et
 * tiroir) mais une seule est atteignable à la fois : la barre est masquée
 * sous `md` (`display: none`) et le `<dialog>` fermé est nativement inerte
 * (`display: none` par la feuille de style de l'agent utilisateur tant que
 * l'attribut `open` n'est pas posé par `showModal()`).
 *
 * Le rail replié garde les icônes seules ; le libellé de chaque rubrique
 * devient une infobulle en pur CSS (`MenuRubriques.astro`, variantes
 * `in-data-[replie=true]:` et `group-hover|group-focus-visible/rubrique:`),
 * visible au survol comme au focus clavier, sans script supplémentaire.
 *
 * Ticket 05 (openspec/changes/005-mise-en-page-administration/tickets/
 * 05-marque-de-brouillon.md, SC-05b) : ce gabarit rend, une fois, le modèle
 * inerte `<template id="modele-marque-brouillon">` — le même composant
 * `MarqueBrouillon.astro` que les écrans qui portent une marque de
 * brouillon (`mes-pages.astro`, `pages/[slug].astro`). C'est ce modèle que
 * `pastille-brouillon.ts` clone côté navigateur après un enregistrement,
 * sans jamais fabriquer la marque à la main.
 */
import Gabarit from './Gabarit.astro';
import Logo from './Logo.astro';
import MarqueBrouillon from './MarqueBrouillon.astro';
import MenuRubriques, { type IdRubriqueServie } from './MenuRubriques.astro';
import { Button } from './composants/ui/button/index.ts';
import PanelLeft from '@lucide/svelte/icons/panel-left';
import Menu from '@lucide/svelte/icons/menu';

interface Props {
  titre: string;
  rubrique: IdRubriqueServie;
}

const { titre, rubrique } = Astro.props;

const ID_BARRE = 'barre-laterale';
const ID_BOUTON_REPLI = 'bouton-repli-menu';
const ID_BOUTON_OUVRIR_TIROIR = 'bouton-ouvrir-tiroir';
const ID_TIROIR = 'tiroir-menu';
---

<Gabarit titre={titre}>
  <div class="flex min-h-dvh bg-background text-foreground">
    <div
      id={ID_BARRE}
      class="relative hidden shrink-0 border-r border-border bg-card md:flex md:w-56 md:flex-col data-[replie=true]:md:w-16 data-[pret=true]:motion-safe:transition-[width] data-[pret=true]:motion-safe:duration-200"
    >
      {
        /*
          `overflow-hidden` ne vaut que déployée (les libellés, dans le flux,
          ne débordent pas pendant l'animation de largeur) : repliée, chaque
          libellé devient une infobulle posée hors du rail, que ce
          rognage couperait.
        */
      }
      <aside
        aria-label="Menu de l'administration"
        class="flex w-full flex-col gap-4 overflow-hidden p-3 in-data-[replie=true]:overflow-visible in-data-[replie=true]:p-2"
      >
        <Logo class="h-8 w-8 shrink-0 in-data-[replie=true]:hidden" />
        <MenuRubriques rubrique={rubrique} />
      </aside>
      {
        /*
          Le bouton de repli est un frère de cet `<aside>` : le landmark
          « Menu de l'administration » ne porte ainsi que la navigation et le
          logo (ticket 03), jamais un contrôle de mise en page — c'est ce que
          `tests/integration/cadre-avec-l-ecran.test.ts` (SC-03b, SC-03c)
          vérifie déjà en n'inspectant que le contenu de cet `<aside>`.
          Déployée, il est posé en haut à droite, à côté du logo (le
          conteneur ci-dessus est le contexte positionné) ; repliée, le logo
          disparaît et le bouton revient dans le flux, sous les icônes — posé
          par-dessus le rail, il masquerait la première rubrique.
        */
      }
      <Button
        id={ID_BOUTON_REPLI}
        type="button"
        variant="ghost"
        size="icon"
        aria-pressed="false"
        aria-label="Replier le menu"
        class="absolute top-2 right-2 shrink-0 in-data-[replie=true]:static in-data-[replie=true]:mx-auto"
      >
        <PanelLeft class="size-4" aria-hidden="true" />
      </Button>
    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <header
        class="sticky top-0 z-10 flex items-center gap-3 border-b border-border bg-card p-3 md:hidden"
      >
        <Button
          id={ID_BOUTON_OUVRIR_TIROIR}
          type="button"
          variant="ghost"
          size="icon"
          aria-haspopup="dialog"
          aria-controls={ID_TIROIR}
          aria-label="Ouvrir le menu"
          class="max-md:min-h-11 max-md:min-w-11"
        >
          <Menu class="size-5" aria-hidden="true" />
        </Button>
        <Logo class="h-7 w-7 shrink-0" />
      </header>
      <main class="min-w-0 flex-1 p-8">
        <slot />
      </main>
    </div>

    <dialog
      id={ID_TIROIR}
      aria-label="Menu de l'administration"
      class="m-0 h-dvh max-h-none w-72 max-w-[85vw] border-0 bg-transparent p-0 backdrop:bg-[var(--overlay)]"
    >
      <div class="flex h-full w-full flex-col gap-4 bg-card p-3">
        <Logo class="h-8 w-8 shrink-0" />
        <MenuRubriques rubrique={rubrique} />
      </div>
    </dialog>
  </div>

  <template id="modele-marque-brouillon"><MarqueBrouillon /></template>

  <script>
    import { activerCadre } from './cadre.ts';

    activerCadre();
  </script>
</Gabarit>
