---
/**
 * Le menu des cinq rubriques de l'administration (ticket 03,
 * openspec/changes/005-mise-en-page-administration/tickets/
 * 03-cadre-avec-l-ecran.md, SC-03a/SC-03c/SC-03d).
 *
 * Une seule liste, une seule source : `GabaritCadre.astro` le rend une fois
 * (dans la barre latérale) à ce ticket ; il sera rendu une seconde fois
 * (dans le tiroir du téléphone) au ticket suivant (04) sans qu'aucune
 * rubrique ne porte alors `aria-current="page"` deux fois pour la même
 * instance — chaque rendu porte son propre marquage, dérivé de la même
 * prop `rubrique`.
 *
 * Seules « Mes pages » et « Médias » mènent à un écran servi (`href`) :
 * elles seules SC-03c. Les trois autres (Réglages, Formulaires, Demandes)
 * situent la navigation sans lien ni bouton — rien qui « offre » un geste
 * vers un écran qui n'existe pas encore, et rien qui ressemble à un geste
 * d'ajout, de retrait, de déplacement ou de renommage de rubrique ou de
 * page.
 *
 * Les icônes `@lucide/svelte` sont des composants Svelte placés ici sans
 * directive `client:*` : Astro les rend en HTML statique, sans script
 * (invariant `I4`, ADR-0006) — c'est ce qui rend le menu déjà présent dans
 * la réponse du serveur (SC-03b), sans attendre l'exécution d'un script.
 *
 * Libellés repris tels quels de l'ancien `Cadre.svelte` (ticket 01) —
 * aucun terme de développeur (SC-03d).
 *
 * Ticket 04 (openspec/changes/005-mise-en-page-administration/tickets/
 * 04-repli-et-tiroir.md) : quand cette instance est rendue à l'intérieur
 * de la barre repliée par `GabaritCadre.astro` (attribut `data-replie`
 * posé par `./cadre.ts` sur un ancêtre — jamais sur le `<dialog>` du
 * tiroir, qui ne le porte jamais), chaque libellé quitte le flux normal
 * pour devenir une infobulle en pur CSS, révélée au survol comme au focus
 * clavier (`group-hover`/`group-focus-visible` sur le lien ou le repère,
 * variantes Tailwind `in-data-[replie=true]:`) — rien de plus, aucun
 * script : la seconde instance (le tiroir) n'a jamais cet ancêtre et
 * garde donc toujours ses libellés en clair (SC-04a, SC-04b).
 */
import type { LucideIcon } from '@lucide/svelte';
import Files from '@lucide/svelte/icons/files';
import ImageIcon from '@lucide/svelte/icons/image';
import Settings from '@lucide/svelte/icons/settings';
import ClipboardList from '@lucide/svelte/icons/clipboard-list';
import Mail from '@lucide/svelte/icons/mail';

export type IdRubriqueServie = 'mes-pages' | 'medias' | 'reglages' | 'formulaires';
type IdRubrique = IdRubriqueServie | 'demandes';

interface Props {
  rubrique: IdRubriqueServie;
}

const { rubrique } = Astro.props;

const ICONES: Readonly<Record<IdRubrique, LucideIcon>> = {
  'mes-pages': Files,
  medias: ImageIcon,
  reglages: Settings,
  formulaires: ClipboardList,
  demandes: Mail,
};

const RUBRIQUES: ReadonlyArray<{ readonly id: IdRubrique; readonly libelle: string; readonly href: string | null }> =
  [
    { id: 'mes-pages', libelle: 'Mes pages', href: '/admin/mes-pages' },
    { id: 'medias', libelle: 'Médias', href: '/admin/medias' },
    { id: 'reglages', libelle: 'Réglages', href: '/admin/reglages' },
    { id: 'formulaires', libelle: 'Formulaires', href: '/admin/formulaires' },
    { id: 'demandes', libelle: 'Demandes', href: null },
  ];
---

<nav>
  <ul class="flex flex-col gap-1">
    {
      RUBRIQUES.map((item) => {
        const Icone = ICONES[item.id];
        const actif = item.id === rubrique;
        const classes = [
          'group/rubrique relative flex items-center gap-2 rounded-lg px-2.5 py-2 text-sm',
          'max-md:min-h-11 max-md:min-w-11',
          'in-data-[replie=true]:justify-center in-data-[replie=true]:px-2',
          actif ? 'bg-primary text-primary-foreground font-medium' : 'text-muted-foreground',
        ].join(' ');
        // Libellé : texte normal quand déployé ; devient une infobulle en
        // pur CSS (posée hors flux, révélée au survol/focus) quand un
        // ancêtre porte `data-replie="true"` — jamais le cas dans le
        // tiroir, qui n'a pas cet ancêtre (voir en-tête du fichier).
        const classesLibelle = [
          'truncate',
          'in-data-[replie=true]:pointer-events-none in-data-[replie=true]:absolute in-data-[replie=true]:left-full in-data-[replie=true]:top-1/2 in-data-[replie=true]:z-20 in-data-[replie=true]:ml-2 in-data-[replie=true]:-translate-y-1/2 in-data-[replie=true]:rounded-md in-data-[replie=true]:border in-data-[replie=true]:border-border in-data-[replie=true]:bg-popover in-data-[replie=true]:px-2 in-data-[replie=true]:py-1 in-data-[replie=true]:text-xs in-data-[replie=true]:whitespace-nowrap in-data-[replie=true]:text-popover-foreground in-data-[replie=true]:opacity-0 in-data-[replie=true]:shadow-raised in-data-[replie=true]:motion-safe:transition-opacity',
          'group-hover/rubrique:opacity-100 group-focus-visible/rubrique:opacity-100',
        ].join(' ');
        return (
          <li>
            {item.href ? (
              <a href={item.href} class={classes} aria-current={actif ? 'page' : undefined}>
                <Icone class="size-4 shrink-0" aria-hidden="true" />
                <span class={classesLibelle}>{item.libelle}</span>
              </a>
            ) : (
              <span class={classes}>
                <Icone class="size-4 shrink-0" aria-hidden="true" />
                <span class={classesLibelle}>{item.libelle}</span>
              </span>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
