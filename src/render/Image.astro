---
/**
 * Une image posée : sa description devient le texte de remplacement ; sans
 * description, l'image est décorative (texte de remplacement vide). Les
 * dimensions déclarées réservent la place. Le même composant reçoit l'image
 * publiée et celle de l'aperçu (I3, ADR-0024). Aucun balisage interprété.
 */
import type { ImageRendue } from '../core/rendu/page.ts';
import { sizesPour, type NatureEmplacement } from './places.ts';

interface Props {
  image: ImageRendue;
  /** La nature de l'emplacement qui la porte : elle fixe la place annoncée. */
  nature?: NatureEmplacement;
}

const { image, nature = 'image' } = Astro.props;
const variantes = image.variantes ?? [];
const avecVariantes = variantes.length > 0;
const srcset = avecVariantes ? variantes.map((v) => `${v.adresse} ${v.largeur}w`).join(', ') : undefined;
const sizes = avecVariantes ? sizesPour(nature) : undefined;
---

<img
  src={image.source}
  srcset={srcset}
  sizes={sizes}
  width={image.largeur}
  height={image.hauteur}
  alt={image.description}
  role={image.description === '' ? 'presentation' : undefined}
  fetchpriority={image.prioritaire ? 'high' : undefined}
  loading={image.prioritaire ? undefined : 'lazy'}
  decoding={image.prioritaire ? undefined : 'async'}
/>
