---
/**
 * Le formulaire de devis posé par un emplacement (change 012, ticket 03 ;
 * ADR-0027, ADR-0029) : tout figure dans le document, sans script — total
 * figé, bouton inactif, textes d'états masqués, message `noscript`. Libellés,
 * noms et options ne sont écrits que par interpolation (I5) ; la mention
 * d'information passe par le rendu Markdown. Les données du futur script sont
 * en attributs `data-*`. Aucun champ fichier, aucun framework.
 */
import type { FormulaireRendu } from '../core/rendu/page.ts';
import TexteRiche from './markdown/TexteRiche.astro';
import { TEXTES_FORMULAIRE as T } from './formulaire/textes.ts';

interface Props {
  formulaire: FormulaireRendu;
}

const { formulaire } = Astro.props;
---

<section class="formulaire">
  <h2>{formulaire.nom}</h2>
  <form novalidate data-formulaire={formulaire.id} data-mode={formulaire.mode}>
    {
      formulaire.champs.map((champ) => {
        const aChoix = champ.nature === 'choix-unique' || champ.nature === 'choix-multiple';
        const nom = `${formulaire.id}-${champ.id}`;
        const type = champ.nature === 'email' ? 'email' : champ.nature === 'telephone' ? 'tel' : 'text';
        return aChoix ? (
          <fieldset
            class="champ"
            data-champ={champ.id}
            data-nature={champ.nature}
            data-obligatoire={champ.obligatoire ? 'oui' : 'non'}
          >
            <legend>
              {champ.libelle}
              {champ.obligatoire && <span class="obligatoire"> {T.obligatoire}</span>}
            </legend>
            {(champ.options ?? []).map((option) => (
              <label class="option">
                <input
                  type={champ.nature === 'choix-unique' ? 'radio' : 'checkbox'}
                  name={nom}
                  value={option.id}
                  data-prix={option.prix}
                />
                <span>{option.libelle}</span>
                {option.prixAffiche !== undefined && <span class="prix"> {option.prixAffiche}</span>}
              </label>
            ))}
          </fieldset>
        ) : (
          <div
            class="champ"
            data-champ={champ.id}
            data-nature={champ.nature}
            data-obligatoire={champ.obligatoire ? 'oui' : 'non'}
          >
            <label for={nom}>
              {champ.libelle}
              {champ.obligatoire && <span class="obligatoire"> {T.obligatoire}</span>}
            </label>
            {champ.nature === 'texte-long' ? (
              <textarea id={nom} name={nom} rows="5" />
            ) : (
              <input id={nom} name={nom} type={type} />
            )}
          </div>
        );
      })
    }
    <p class="total">{T.totalEstime} <output data-total>{T.totalInitial}</output></p>
    <p class="estimation">{T.estimationIndicative}</p>
    <div class="mention"><TexteRiche document={formulaire.mention} /></div>
    <button type="submit" disabled>{T.boutonEnvoi}</button>
    <p class="etat" data-etat="envoi" hidden>{T.envoiEnCours}</p>
    <p class="etat" data-etat="confirmation" hidden>{T.confirmation}</p>
    <p class="etat" data-etat="echec" hidden>{T.echecEnvoi}</p>
    <p class="etat" data-etat="limite" hidden>{T.echecLimite}</p>
    <p class="etat" data-etat="modifie" hidden>{T.echecFormulaireModifie}</p>
    <noscript><p class="etat">{T.sansScript}</p></noscript>
  </form>
</section>
