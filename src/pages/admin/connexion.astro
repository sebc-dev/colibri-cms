---
/**
 * L'écran de connexion (ticket 01 — la porte close ; ticket 03 —
 * specs/001-connexion-par-code/03-code-vers-adresse-autorisee.md ; ticket 04
 * — égalité de réponse).
 *
 * Il importe le garde de session comme toute route d'administration
 * (ADR-0007), mais il n'est pas une route gardée (SPEC.md) : c'est ce qui
 * rend la porte atteignable. Le verdict n'est donc jamais utilisé pour
 * bloquer l'accès — l'écran se sert identiquement avec ou sans session.
 *
 * Une seule route porte les deux étapes (SPEC.md § Décisions
 * d'implémentation) : le GET pose l'identifiant d'appareil (cookie
 * `identifiant-appareil`) s'il manque, jamais le POST — posé à la
 * soumission, il ne le serait que pour l'adresse autorisée et sa seule
 * présence la trahirait ; réémis à chaque affichage, deux onglets ouverts
 * s'annuleraient. Le POST traite la soumission d'adresse : il n'écrit un
 * code que si l'adresse correspond à l'adresse autorisée (FR-005) — toute
 * autre adresse n'a aucun effet sur ce qui est écrit.
 *
 * Ticket 04 — égalité de réponse (`src/core/auth/
 * regles.ts`) : la réponse n'est jamais rendue avant le délai plancher
 * gelé en source, qu'une adresse ait été reconnue ou non ; et l'expédition
 * — seul travail dont la durée varie selon l'adresse — n'est remise à la
 * liaison `EXPEDITEUR_CODE_CONNEXION` qu'après, jamais avant, via
 * `Astro.locals.cfContext.waitUntil` (l'exécution différée d'un délai nul
 * garantit qu'aucun de ses effets, y compris l'appel `send` lui-même, ne se
 * produit avant que la réponse ait quitté cette route).
 */
import Gabarit from '../../admin/Gabarit.astro';
import { verifierSession } from '../../platform/session/index.ts';
import { env } from 'cloudflare:workers';
import { DUREE_DE_VIE_CODE_SECONDES } from '../../core/auth/code.ts';
import { DELAI_PLANCHER_MS, attendre } from '../../core/auth/regles.ts';
import { estAdresseAutorisee, ecrireCode } from '../../platform/auth/magasin.ts';
import { demanderExpeditionDuCode } from '../../platform/email/index.ts';

verifierSession(Astro.request);

const NOM_COOKIE_APPAREIL = 'identifiant-appareil';
const estSoumission = Astro.request.method === 'POST';

let identifiantAppareil = Astro.cookies.get(NOM_COOKIE_APPAREIL)?.value;
if (!identifiantAppareil && !estSoumission) {
  identifiantAppareil = crypto.randomUUID();
  Astro.cookies.set(NOM_COOKIE_APPAREIL, identifiantAppareil, {
    path: '/',
    maxAge: DUREE_DE_VIE_CODE_SECONDES,
    httpOnly: true,
    secure: true,
    sameSite: 'lax',
  });
}

if (estSoumission) {
  const debut = Date.now();
  const donnees = await Astro.request.formData();
  const adresse = String(donnees.get('adresse') ?? '');

  let demandeExpedition: (() => Promise<void>) | null = null;
  try {
    if (identifiantAppareil && (await estAdresseAutorisee(env.DB, adresse))) {
      const code = await ecrireCode(env.DB, identifiantAppareil);
      demandeExpedition = () => demanderExpeditionDuCode(env.EXPEDITEUR_CODE_CONNEXION, adresse, code);
    }
  } catch {
    demandeExpedition = null;
  }

  // Le plancher (ticket 04, SPEC.md § Décisions d'implémentation) : la
  // réponse ne part jamais avant lui, que l'adresse soit reconnue ou non —
  // c'est ce qui rend le temps de réponse indépendant du travail fait, donc
  // de l'adresse soumise.
  const reste = DELAI_PLANCHER_MS - (Date.now() - debut);
  if (reste > 0) await attendre(reste);

  if (demandeExpedition) {
    // Remise à la plateforme différée au-delà de cette réponse : `waitUntil`
    // maintient seulement le worker vivant le temps que la promesse se
    // termine, il ne diffère pas à lui seul l'appel qu'on lui passe —
    // `attendre(0)` avant l'appel réel garantit qu'aucun de ses effets (y
    // compris l'appel `send` lui-même) ne s'exécute avant que la réponse ait
    // quitté cette route. Une expédition qui échoue ne change donc jamais ce
    // qui a déjà été rendu (le `.catch` l'absorbe silencieusement).
    Astro.locals.cfContext.waitUntil(attendre(0).then(demandeExpedition).catch(() => {}));
  }
}
---

<Gabarit titre="Connexion">
  <h1>Connexion</h1>
  <p>Saisissez l’adresse déjà connue pour recevoir un code.</p>
  <form method="post">
    <label for="adresse">Adresse</label>
    <input id="adresse" name="adresse" type="email" required />
    <button type="submit">Recevoir un code</button>
  </form>
</Gabarit>
