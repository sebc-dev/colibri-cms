---
/**
 * L'écran qui monte le cadre de l'administration (ticket 01,
 * specs/003-remplir-emplacements/01-cadre-administration.md).
 *
 * Route gardée comme toute route d'administration (ADR-0007), à l'identique
 * de `src/pages/admin/index.astro` et `src/pages/admin/ilots.astro` (002).
 *
 * Fichier distinct de `src/pages/admin/index.astro` — pas « (ou équivalent) »
 * par commodité : `index.astro` reste sous le contrat figé par
 * `tests/integration/code-ouvre-la-session.test.ts` **et**
 * `tests/static/gabarits-admin.test.ts` (ticket 06 et ticket 01 de
 * 001-connexion-par-code, couture verrouillée sur la réponse ET sur la
 * source, jamais éditée ici).
 * Le choix d'une route dédiée pour « Mes pages » et l'assemblage de cet
 * écran dans ce cadre sont posés par le ticket 02, bloqué par celui-ci
 * (openspec/changes/003-remplir-emplacements/tickets/02-liste-des-pages.md,
 * section « Ce que ça livre »). Ce ticket-ci prouve seulement que le
 * cadre — le substrat commun — se monte et se rend sous les en-têtes réels
 * (CSP stricte, ADR-0010).
 *
 * Aucune directive `client:*` (ADR-0006) : l'îlot se monte par le `<script>`
 * de module ci-dessous (jamais `is:inline`), qui importe le point d'entrée
 * externe `src/admin/ilots-svelte-5/monter.ts` — même patron que 002.
 */
import Gabarit from '../../admin/Gabarit.astro';
import { verifierSession } from '../../platform/session/index.ts';
import { env } from 'cloudflare:workers';

const session = await verifierSession(env.DB, Astro.request);
if (!session) {
  return Astro.redirect('/admin/connexion');
}
---

<Gabarit titre="Mes pages — Administration">
  <div id="ilot-cadre"></div>
  <script>
    import { monterCadre } from '../../admin/ilots-svelte-5/monter.ts';

    monterCadre('ilot-cadre');
  </script>
</Gabarit>
