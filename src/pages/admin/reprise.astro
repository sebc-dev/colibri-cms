---
/**
 * L'écran de saisie du code de secours (change 016, ticket 02, ADR-0032).
 * Route non gardée comme la connexion : le garde de session est importé et
 * appelé sans bloquer (ADR-0007). Rendu serveur sans directive client (I4).
 */
import Gabarit from '../../admin/Gabarit.astro';
import Logo from '../../admin/Logo.astro';
import { Card, CardContent, CardHeader } from '../../admin/composants/ui/card/index.ts';
import { Input } from '../../admin/composants/ui/input/index.ts';
import { Label } from '../../admin/composants/ui/label/index.ts';
import { Alert, AlertDescription } from '../../admin/composants/ui/alert/index.ts';
import { Button } from '../../admin/composants/ui/button/index.ts';
import { verifierSession, enteteCookieSession } from '../../platform/session/index.ts';
import { ouvrirSessionParCodeDeSecours } from '../../platform/auth/code-de-secours.ts';
import { env } from 'cloudflare:workers';
import {
  TEXTE_TITRE_REPRISE,
  TEXTE_INVITE_REPRISE,
  TEXTE_LIBELLE_CODE_DE_SECOURS,
  TEXTE_BOUTON_REPRISE,
  TEXTE_REFUS_REPRISE,
  TEXTE_LIEN_RETOUR_CONNEXION,
} from '../../admin/textes.ts';

await verifierSession(env.DB, Astro.request);

let refuse = false;
if (Astro.request.method === 'POST') {
  const donnees = await Astro.request.formData();
  const saisie = String(donnees.get('code') ?? '');
  const resultat = await ouvrirSessionParCodeDeSecours(
    env.DB,
    saisie,
    Astro.cookies.get('identifiant-appareil')?.value,
    Date.now(),
  );
  if (resultat.reussi) {
    const reponse = Astro.redirect('/admin/');
    reponse.headers.append('Set-Cookie', enteteCookieSession(resultat.jeton));
    return reponse;
  }
  refuse = true;
}
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Gabarit titre={TEXTE_TITRE_REPRISE}>
  <main class="flex min-h-dvh justify-center px-4 py-10">
    <Card class="h-fit w-full max-w-[400px]">
      <CardHeader class="flex flex-col items-center gap-3 text-center">
        <Logo class="h-10 w-10" />
        <h1>{TEXTE_TITRE_REPRISE}</h1>
      </CardHeader>
      <CardContent class="flex flex-col gap-6">
        <form method="post" class="flex flex-col gap-3">
          <p>{TEXTE_INVITE_REPRISE}</p>
          {
            refuse && (
              <Alert variant="destructive">
                <AlertDescription>{TEXTE_REFUS_REPRISE}</AlertDescription>
              </Alert>
            )
          }
          <div class="flex flex-col gap-1.5">
            <Label for="code">{TEXTE_LIBELLE_CODE_DE_SECOURS}</Label>
            <Input
              id="code"
              name="code"
              type="text"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              required
              class="max-md:min-h-11"
            />
          </div>
          <Button type="submit" class="max-md:min-h-11 max-md:min-w-11">{TEXTE_BOUTON_REPRISE}</Button>
        </form>
        <a href="/admin/connexion" class="border-t border-line pt-6 text-sm underline">{TEXTE_LIEN_RETOUR_CONNEXION}</a>
      </CardContent>
    </Card>
  </main>
</Gabarit>
