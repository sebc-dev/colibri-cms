---
/**
 * L'écran d'accueil de l'administration (ticket 01 — la porte close ;
 * ticket 06 — le code recopié ouvre la session,
 * specs/001-connexion-par-code/06-code-ouvre-la-session.md).
 *
 * Derrière la garde : `verifierSession` renvoie toute requête sans session
 * valide vers l'écran de connexion (C1, C4) ; une fois la session ouverte
 * par ce ticket, l'accueil devient réellement atteignable. Il ne porte
 * toujours lui-même aucune fonction — ni lien, ni action — il n'est que le
 * point d'arrivée du parcours.
 *
 * Frontière figée par `tests/static/gabarits-admin.test.ts` (ticket 01 de
 * 001-connexion-par-code) : la source de ce fichier ne doit porter aucun
 * lien, aucun formulaire, aucun bouton, aucun attribut d'action ni aucun
 * terme de développeur — vérifié sur la source elle-même, pas seulement sur
 * la réponse rendue. Le ticket 02 de 003-remplir-emplacements (la liste des
 * pages, openspec/changes/003-remplir-emplacements/tickets/
 * 02-liste-des-pages.md) sert donc « Mes pages » sur une route dédiée
 * (`src/pages/admin/mes-pages.astro`), jamais ici : l'hypothèse posée par le
 * commentaire de `cadre.astro` ne tient pas face à cette frontière déjà en
 * place — ce fichier reste donc, à dessein, non révisé par ce ticket.
 */
import Gabarit from '../../admin/Gabarit.astro';
import { verifierSession } from '../../platform/session/index.ts';
import { env } from 'cloudflare:workers';

const session = await verifierSession(env.DB, Astro.request);
if (!session) {
  return Astro.redirect('/admin/connexion');
}
---

<Gabarit titre="Administration">
  <p>Vous êtes connectée.</p>
</Gabarit>
