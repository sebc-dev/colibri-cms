---
/**
 * L'écran « Adresse e-mail » (change 017, ticket 01, ADR-0033). Rendu serveur
 * sans îlot (I4), garde de session importée (ADR-0007), adresse interpolée
 * (I5). Le POST `proposer` inscrit l'adresse chez Cloudflare et ouvre le
 * remplacement ; chaque POST rend l'écran suivant sans redirection.
 */
import GabaritCadre from '../../admin/GabaritCadre.astro';
import { Alert, AlertDescription } from '../../admin/composants/ui/alert/index.ts';
import { Card, CardContent } from '../../admin/composants/ui/card/index.ts';
import { Button } from '../../admin/composants/ui/button/index.ts';
import { Input } from '../../admin/composants/ui/input/index.ts';
import { Label } from '../../admin/composants/ui/label/index.ts';
import { verifierSession } from '../../platform/session/index.ts';
import { lireAdresseAutorisee } from '../../platform/auth/magasin.ts';
import { remplacementPossible } from '../../core/auth/remplacement.ts';
import { EMAIL_FORME } from '../../core/reglages/coordonnees.ts';
import { inscrireAdresse } from '../../platform/adresses-cloudflare/index.ts';
import { lireRemplacementEnCours, ouvrirRemplacement } from '../../platform/auth/remplacement-adresse.ts';
import {
  TEXTE_BOUTON_CHANGER_ADRESSE,
  TEXTE_LABEL_NOUVELLE_ADRESSE,
  TEXTE_TITRE_ADRESSE_EMAIL,
  TEXTE_ADRESSE_EN_PLACE,
  texteChangementAdresseImpossible,
  TEXTE_REFUS_ADRESSE_FORME,
  TEXTE_REFUS_ADRESSE_DEJA_EN_PLACE,
  TEXTE_BOUTON_JAI_CLIQUE,
  TEXTE_LIEN_REVENIR_AUX_REGLAGES,
  texteChangementAdresseEchoue,
  texteMessageVaArriver,
  texteAdresseResteEnPlace,
} from '../../admin/textes.ts';
import { env } from 'cloudflare:workers';

const session = await verifierSession(env.DB, Astro.request);
if (!session) {
  return Astro.redirect('/admin/connexion');
}

Astro.response.headers.set('Cache-Control', 'no-store');

const adresse = (await lireAdresseAutorisee(env.DB)) ?? '';
const compte = __COMPTE_CLOUDFLARE__ ?? undefined;
const cle = env.JETON_ADRESSES_EMAIL;
const possible = remplacementPossible(compte, cle);

let refus: string | null = null;
if (Astro.request.method === 'POST' && possible && compte !== undefined && cle !== undefined) {
  const formulaire = await Astro.request.formData();
  if (formulaire.get('etape') === 'proposer') {
    const saisie = String(formulaire.get('adresse') ?? '').trim();
    if (!EMAIL_FORME.test(saisie)) {
      refus = TEXTE_REFUS_ADRESSE_FORME;
    } else if (saisie.toLowerCase() === adresse.toLowerCase()) {
      refus = TEXTE_REFUS_ADRESSE_DEJA_EN_PLACE;
    } else {
      const resultat = await inscrireAdresse(cle, compte, saisie);
      if (resultat === 'echec') {
        refus = texteChangementAdresseEchoue(adresse);
      } else {
        await ouvrirRemplacement(env.DB, saisie, session, Date.now());
      }
    }
  }
}
const enCours = possible ? await lireRemplacementEnCours(env.DB) : null;
---

<GabaritCadre titre="Adresse e-mail — Administration" rubrique="reglages">
  <h1>{TEXTE_TITRE_ADRESSE_EMAIL}</h1>
  <div class="mt-6 flex flex-col gap-4">
    {
      possible ? (
        <>
        <Card>
          <CardContent class="flex flex-col gap-4">
            {enCours !== null ? (
              <>
                <p>{texteMessageVaArriver(enCours)}</p>
                <button type="submit" form="verifier" class="h-auto w-full rounded-md border px-3 py-2 max-md:min-h-11 md:w-auto">{TEXTE_BOUTON_JAI_CLIQUE}</button>
                <a href="/admin/reglages" class="inline-flex min-h-11 items-center underline underline-offset-2">{TEXTE_LIEN_REVENIR_AUX_REGLAGES}</a>
                <p>{texteAdresseResteEnPlace(adresse)}</p>
              </>
            ) : null}
            {refus !== null ? (
              <Alert class="border-transparent bg-ambre-soft">
                <AlertDescription class="text-ambre">{refus}</AlertDescription>
              </Alert>
            ) : null}
            <p>{TEXTE_ADRESSE_EN_PLACE}</p>
            <p class="font-medium">{adresse}</p>
            <form method="post" class="flex flex-col gap-3">
              <input type="hidden" name="etape" value="proposer" />
              <div class="flex flex-col gap-1.5">
                <Label for="adresse">{TEXTE_LABEL_NOUVELLE_ADRESSE}</Label>
                <Input id="adresse" name="adresse" type="email" autocomplete="email" required class="max-md:min-h-11" />
              </div>
              <Button type="submit" class="h-auto w-full rounded-md px-3 py-2 max-md:min-h-11 md:w-auto">{TEXTE_BOUTON_CHANGER_ADRESSE}</Button>
            </form>
          </CardContent>
        </Card>
        <form id="verifier" method="post">
          <input type="hidden" name="etape" value="verifier" />
        </form>
        </>
      ) : (
        <Alert class="border-transparent bg-ambre-soft">
          <AlertDescription class="text-ambre">{texteChangementAdresseImpossible(adresse)}</AlertDescription>
        </Alert>
      )
    }
  </div>
</GabaritCadre>
