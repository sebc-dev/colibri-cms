---
/**
 * L'écran « Adresse e-mail » (change 017, ticket 01, ADR-0033). Rendu serveur
 * sans îlot (I4), garde de session importée (ADR-0007), adresse interpolée
 * (I5). Le POST `proposer` inscrit l'adresse chez Cloudflare et ouvre le
 * remplacement ; chaque POST rend l'écran suivant sans redirection.
 */
import GabaritCadre from '../../admin/GabaritCadre.astro';
import { Alert, AlertDescription } from '../../admin/composants/ui/alert/index.ts';
import { Card, CardContent } from '../../admin/composants/ui/card/index.ts';
import { Button } from '../../admin/composants/ui/button/index.ts';
import { Input } from '../../admin/composants/ui/input/index.ts';
import { Label } from '../../admin/composants/ui/label/index.ts';
import { verifierSession } from '../../platform/session/index.ts';
import { lireAdresseAutorisee } from '../../platform/auth/magasin.ts';
import { confirmationRecente } from '../../core/auth/regles.ts';
import { remplacementPossible } from '../../core/auth/remplacement.ts';
import { EMAIL_FORME } from '../../core/reglages/coordonnees.ts';
import { inscrireAdresse, lireAdresse } from '../../platform/adresses-cloudflare/index.ts';
import { basculerSiCodeValide, codeRecopiableExiste, ecrireCodeDeRemplacement, libererMessageRemplacement, lireRemplacementEnCours, ouvrirRemplacement, reserverMessageRemplacement } from '../../platform/auth/remplacement-adresse.ts';
import {
  TEXTE_BOUTON_CHANGER_ADRESSE,
  TEXTE_LABEL_NOUVELLE_ADRESSE,
  TEXTE_TITRE_ADRESSE_EMAIL,
  TEXTE_ADRESSE_EN_PLACE,
  texteChangementAdresseImpossible,
  TEXTE_REFUS_ADRESSE_FORME,
  TEXTE_REFUS_ADRESSE_DEJA_EN_PLACE,
  TEXTE_BOUTON_JAI_CLIQUE,
  TEXTE_LIEN_REVENIR_AUX_REGLAGES,
  texteChangementAdresseEchoue,
  texteMessageVaArriver,
  texteAdresseResteEnPlace,
  TEXTE_CLIC_PAS_ENCORE_ENREGISTRE,
  TEXTE_CONFIRMATION_RECENTE,
  TEXTE_CONFIRMATION_RECENTE_APRES_CODE,
  TEXTE_PLAFOND_MESSAGES_REMPLACEMENT,
  texteCodeEstParti,
  TEXTE_RECOPIER_LE_CODE,
  TEXTE_LABEL_CODE,
  TEXTE_BOUTON_VALIDER,
  TEXTE_BOUTON_NOUVEAU_CODE,
  texteAdresseChangee,
  texteAncienneAdressePrevenue,
  TEXTE_CODE_A_RETAPER,
  TEXTE_CODE_A_REDEMANDER,
} from '../../admin/textes.ts';
import { demanderExpeditionDuCodeDeRemplacement, demanderAvisDeRemplacement } from '../../platform/email/index.ts';
import { env } from 'cloudflare:workers';

const session = await verifierSession(env.DB, Astro.request);
if (!session) {
  return Astro.redirect('/admin/connexion');
}

Astro.response.headers.set('Cache-Control', 'no-store');

const compte = __COMPTE_CLOUDFLARE__ ?? undefined;
const cle = env.JETON_ADRESSES_EMAIL;
const possible = remplacementPossible(compte, cle);

let adresse = (await lireAdresseAutorisee(env.DB)) ?? '';
let refus: string | null = null;
let etapeCode = false;
let nouvelleAdresse: string | null = null;
let ancienneAdresse: string | null = null;
if (Astro.request.method === 'POST' && possible && compte !== undefined && cle !== undefined) {
  const formulaire = await Astro.request.formData();
  if (formulaire.get('etape') === 'proposer') {
    const saisie = String(formulaire.get('adresse') ?? '').trim();
    if (!EMAIL_FORME.test(saisie)) {
      refus = TEXTE_REFUS_ADRESSE_FORME;
    } else if (saisie.toLowerCase() === adresse.toLowerCase()) {
      refus = TEXTE_REFUS_ADRESSE_DEJA_EN_PLACE;
    } else {
      const instant = Date.now();
      if (!(await reserverMessageRemplacement(env.DB, instant))) {
        refus = TEXTE_PLAFOND_MESSAGES_REMPLACEMENT;
      } else {
        const resultat = await inscrireAdresse(cle, compte, saisie);
        if (resultat === 'deja-inscrite') await libererMessageRemplacement(env.DB, instant);
        if (resultat === 'echec') {
          refus = texteChangementAdresseEchoue(adresse);
        } else {
          await ouvrirRemplacement(env.DB, saisie, session, Date.now());
        }
      }
    }
  } else if (formulaire.get('etape') === 'verifier') {
    const nouvelle = await lireRemplacementEnCours(env.DB);
    if (nouvelle !== null) {
      const { etat, verifieeLe } = await lireAdresse(cle, compte, nouvelle);
      if (etat === 'echec') {
        refus = texteChangementAdresseEchoue(adresse);
      } else if (etat !== 'verifiee') {
        refus = TEXTE_CLIC_PAS_ENCORE_ENREGISTRE;
      } else if (verifieeLe !== null && confirmationRecente(verifieeLe, Date.now())) {
        const depuisCode = await codeRecopiableExiste(env.DB, session, Date.now());
        etapeCode = depuisCode;
        refus = depuisCode ? TEXTE_CONFIRMATION_RECENTE_APRES_CODE : TEXTE_CONFIRMATION_RECENTE;
      } else {
        const code = await ecrireCodeDeRemplacement(env.DB, session, Date.now());
        if (code === null) {
          refus = TEXTE_PLAFOND_MESSAGES_REMPLACEMENT;
        } else {
          etapeCode = true;
          Astro.locals.cfContext.waitUntil(
            Promise.resolve()
              .then(() => demanderExpeditionDuCodeDeRemplacement(env.EXPEDITEUR_CODE_CONNEXION, nouvelle, code, __ADRESSE_EXPEDITEUR__))
              .catch((erreur: unknown) => {
                console.error(`[adresse] envoi du code échoué (${erreur instanceof Error ? erreur.name : 'inconnu'})`);
              }),
          );
        }
      }
    }
  } else if (formulaire.get('etape') === 'code') {
    const issue = await basculerSiCodeValide(env.DB, session, String(formulaire.get('code') ?? ''), Date.now());
    if (issue.reussi) {
      nouvelleAdresse = issue.nouvelle;
      ancienneAdresse = issue.ancienne;
      if (issue.ancienne !== null) {
        const ancienne = issue.ancienne;
        Astro.locals.cfContext.waitUntil(
          Promise.resolve()
            .then(() => demanderAvisDeRemplacement(env.EXPEDITEUR_CODE_CONNEXION, ancienne, issue.nouvelle, new Date(), __ADRESSE_EXPEDITEUR__))
            .catch((erreur: unknown) => {
              console.error(`[adresse] envoi de l'avis échoué (${erreur instanceof Error ? erreur.name : 'inconnu'})`);
            }),
        );
      }
    } else {
      etapeCode = (await lireRemplacementEnCours(env.DB)) !== null;
      refus = issue.raison === 'introuvable' ? TEXTE_CODE_A_RETAPER : TEXTE_CODE_A_REDEMANDER;
    }
  }
}
if (nouvelleAdresse !== null) adresse = nouvelleAdresse;
const enCours = possible ? await lireRemplacementEnCours(env.DB) : null;
---

<GabaritCadre titre="Adresse e-mail — Administration" rubrique="reglages">
  <h1>{TEXTE_TITRE_ADRESSE_EMAIL}</h1>
  <div class="mt-6 flex flex-col gap-4">
    {
      possible ? (
        <>
        {nouvelleAdresse !== null ? (
        <Card>
          <CardContent class="flex flex-col gap-4">
            <p>{texteAdresseChangee(nouvelleAdresse)}</p>
            {ancienneAdresse !== null ? <p>{texteAncienneAdressePrevenue(ancienneAdresse)}</p> : null}
            <a href="/admin/reglages" class="inline-flex min-h-11 items-center underline underline-offset-2">{TEXTE_LIEN_REVENIR_AUX_REGLAGES}</a>
          </CardContent>
        </Card>
        ) : (
        <Card>
          <CardContent class="flex flex-col gap-4">
            {enCours !== null && etapeCode ? (
              <>
                <p>{texteCodeEstParti(enCours)}</p>
                <p>{TEXTE_RECOPIER_LE_CODE}</p>
                <form method="post" class="flex flex-col gap-3">
                  <input type="hidden" name="etape" value="code" />
                  <div class="flex flex-col gap-1.5">
                    <Label for="code">{TEXTE_LABEL_CODE}</Label>
                    <Input id="code" name="code" type="text" autocomplete="one-time-code" required class="max-md:min-h-11" />
                  </div>
                  <Button type="submit" class="h-auto w-full rounded-md px-3 py-2 max-md:min-h-11 md:w-auto">{TEXTE_BOUTON_VALIDER}</Button>
                </form>
                <button type="submit" form="verifier" class="h-auto w-full rounded-md border px-3 py-2 max-md:min-h-11 md:w-auto">{TEXTE_BOUTON_NOUVEAU_CODE}</button>
                <p>{texteAdresseResteEnPlace(adresse)}</p>
              </>
            ) : enCours !== null ? (
              <>
                <p>{texteMessageVaArriver(enCours)}</p>
                <button type="submit" form="verifier" class="h-auto w-full rounded-md border px-3 py-2 max-md:min-h-11 md:w-auto">{TEXTE_BOUTON_JAI_CLIQUE}</button>
                <a href="/admin/reglages" class="inline-flex min-h-11 items-center underline underline-offset-2">{TEXTE_LIEN_REVENIR_AUX_REGLAGES}</a>
                <p>{texteAdresseResteEnPlace(adresse)}</p>
              </>
            ) : null}
            {refus !== null ? (
              <Alert class="border-transparent bg-ambre-soft">
                <AlertDescription class="text-ambre">{refus}</AlertDescription>
              </Alert>
            ) : null}
            <p>{TEXTE_ADRESSE_EN_PLACE}</p>
            <p class="font-medium">{adresse}</p>
            <form method="post" class="flex flex-col gap-3">
              <input type="hidden" name="etape" value="proposer" />
              <div class="flex flex-col gap-1.5">
                <Label for="adresse">{TEXTE_LABEL_NOUVELLE_ADRESSE}</Label>
                <Input id="adresse" name="adresse" type="email" autocomplete="email" required class="max-md:min-h-11" />
              </div>
              <Button type="submit" class="h-auto w-full rounded-md px-3 py-2 max-md:min-h-11 md:w-auto">{TEXTE_BOUTON_CHANGER_ADRESSE}</Button>
            </form>
          </CardContent>
        </Card>
        )}
        <form id="verifier" method="post">
          <input type="hidden" name="etape" value="verifier" />
        </form>
        </>
      ) : (
        <Alert class="border-transparent bg-ambre-soft">
          <AlertDescription class="text-ambre">{texteChangementAdresseImpossible(adresse)}</AlertDescription>
        </Alert>
      )
    }
  </div>
</GabaritCadre>
