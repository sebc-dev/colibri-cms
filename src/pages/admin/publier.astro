---
/**
 * L'`Écran : Publier` (change 011, ticket 10) : le récapitulatif des pages,
 * réglages et formulaires qui portent un brouillon. Il ne met rien en ligne par lui-même
 * (la confirmation est l'îlot `EcranPublier`, ticket 15). Rendu serveur, garde de
 * session importée (I6, ADR-0007), aucun `client:*` : l'îlot est monté par script (I4, ADR-0006).
 * Les noms sont interpolés échappés (I5). « Annuler » ramène à l'écran
 * quitté, dont l'adresse est revérifiée (`retourSur`).
 */
import { Button } from '../../admin/composants/ui/button/index.ts';
import GabaritCadre from '../../admin/GabaritCadre.astro';
import MontageEcranPublier from '../../admin/MontageEcranPublier.astro';
import { verifierSession } from '../../platform/session/index.ts';
import { calculerEtatPublication, lireEtatDeLaPublication } from '../../platform/publication/publier.ts';
import { recapitulatifEstVide, retourSur } from '../../core/publication/recapitulatif.ts';
import { adresseDeLaPage } from '../../core/pages/declaration.ts';
import {
  TEXTE_BOUTON_ANNULER_PUBLIER,
  TEXTE_PUBLICATION_CHANGEMENT,
  TEXTE_INTRO_PUBLIER,
  TEXTE_LIEN_VOIR_APERCU,
  TEXTE_REVENIR_A_MES_PAGES,
  TEXTE_RIEN_A_PUBLIER,
  TEXTE_SECTION_FORMULAIRES_PUBLIER,
  TEXTE_SECTION_PAGES_PUBLIER,
  TEXTE_SECTION_IMAGES_REDECRITES_PUBLIER,
  TEXTE_SECTION_IMAGES_EFFACEES_PUBLIER,
  TEXTE_IMAGES_EFFACEES_EXPLICATION,
  TEXTE_SECTION_REGLAGES_PUBLIER,
  TEXTE_TITRE_PUBLIER,
  TEXTE_PUBLICATION_BOUTON_RELANCER,
  TEXTE_PUBLICATION_ETAT_EN_COURS,
  TEXTE_PUBLICATION_ETAT_EN_LIGNE,
  TEXTE_PUBLICATION_ETAT_PAS_ABOUTI,
  TEXTE_PUBLICATION_LIEN_VOIR_MON_SITE,
  TEXTE_PUBLICATION_PASTILLE_EN_TRAIN_DE_PARTIR,
  LIBELLES_REGLAGES_PUBLIER,
} from '../../admin/textes.ts';
import { env } from 'cloudflare:workers';

const session = await verifierSession(env.DB, Astro.request);
if (!session) {
  return Astro.redirect('/admin/connexion');
}

Astro.response.headers.set('Cache-Control', 'no-store');

const { recapitulatif, empreinte } = await calculerEtatPublication(env.DB, Date.now());
const etat = await lireEtatDeLaPublication(env.DB, Date.now());
const rien = recapitulatifEstVide(recapitulatif);
const changement = Astro.url.searchParams.get('message') === 'changement';
const retour = retourSur(Astro.url.searchParams.get('retour'));
const classeListe = 'mt-2 divide-y divide-border rounded-lg border border-border bg-card [&>li]:min-h-11 [&>li]:break-words [&>li]:px-4 [&>li]:py-3';
---

<GabaritCadre titre="Publier — Administration">
  <h1>{TEXTE_TITRE_PUBLIER}</h1>
  {
    etat === 'en-cours' && (
      <p class="mt-4 rounded-lg border border-border bg-card p-4" role="status" data-etat-publication="en-cours">{TEXTE_PUBLICATION_ETAT_EN_COURS}</p>
    )
  }
  {
    etat === 'en-train-de-partir' && (
      <p class="mt-4 rounded-lg border border-border bg-card p-4" role="status" data-etat-publication="en-train-de-partir">{TEXTE_PUBLICATION_PASTILLE_EN_TRAIN_DE_PARTIR}</p>
    )
  }
  {
    etat === 'en-ligne' && (
      <p class="mt-4 rounded-lg border border-border bg-card p-4" role="status" data-etat-publication="en-ligne">
        {TEXTE_PUBLICATION_ETAT_EN_LIGNE} <a href="/" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-plumage underline underline-offset-2">{TEXTE_PUBLICATION_LIEN_VOIR_MON_SITE}</a>
      </p>
    )
  }
  {
    etat === 'pas-abouti' && (
      <p class="mt-4 rounded-lg bg-danger-soft p-4 text-danger" role="status" data-etat-publication="pas-abouti">{TEXTE_PUBLICATION_ETAT_PAS_ABOUTI}</p>
    )
  }
  {changement && <p class="mt-4 rounded-lg border border-border bg-card p-4" role="status" data-publication-changee>{TEXTE_PUBLICATION_CHANGEMENT}</p>}
  {
    rien ? (
      <div class="mt-6 rounded-lg border border-border bg-card p-4 text-ink-muted">
        <p data-rien-a-publier>{TEXTE_RIEN_A_PUBLIER}</p>
        <p class="mt-4"><a href="/admin/mes-pages" class="inline-flex min-h-11 items-center text-plumage underline underline-offset-2">{TEXTE_REVENIR_A_MES_PAGES}</a></p>
      </div>
    ) : (
      <>
        <p class="mt-4">{TEXTE_INTRO_PUBLIER}</p>
        {recapitulatif.pages.length > 0 && (
          <section class="mt-6" data-recap-pages>
            <h2>{TEXTE_SECTION_PAGES_PUBLIER}</h2>
            <ul class={classeListe}>
              {recapitulatif.pages.map((page) => (
                <li>{page.titre} <a href={`/admin/apercu${adresseDeLaPage(page.slug)}`} class="inline-flex min-h-11 items-center text-plumage underline underline-offset-2">{TEXTE_LIEN_VOIR_APERCU}</a></li>
              ))}
            </ul>
          </section>
        )}
        {recapitulatif.reglages.length > 0 && (
          <section class="mt-6" data-recap-reglages>
            <h2>{TEXTE_SECTION_REGLAGES_PUBLIER}</h2>
            <ul class={classeListe}>
              {recapitulatif.reglages.map((reglage) => <li>{LIBELLES_REGLAGES_PUBLIER[reglage.nom] ?? reglage.libelle}</li>)}
            </ul>
          </section>
        )}
        {recapitulatif.formulaires.length > 0 && (
          <section class="mt-6" data-recap-formulaires>
            <h2>{TEXTE_SECTION_FORMULAIRES_PUBLIER}</h2>
            <ul class={classeListe}>
              {recapitulatif.formulaires.map((formulaire) => <li>{formulaire.nom}</li>)}
            </ul>
          </section>
        )}
        {recapitulatif.imagesRedecrites.length > 0 && (
          <section class="mt-6" data-recap-images-redecrites>
            <h2>{TEXTE_SECTION_IMAGES_REDECRITES_PUBLIER}</h2>
            <ul class={classeListe}>
              {recapitulatif.imagesRedecrites.map((image) => <li>{image.nom}</li>)}
            </ul>
          </section>
        )}
        {recapitulatif.imagesEffacees.length > 0 && (
          <section class="mt-6" data-recap-images-effacees>
            <h2>{TEXTE_SECTION_IMAGES_EFFACEES_PUBLIER}</h2>
            <p class="mt-2 text-ink-muted">{TEXTE_IMAGES_EFFACEES_EXPLICATION}</p>
            <ul class={classeListe}>
              {recapitulatif.imagesEffacees.map((image) => (
                <li><img src={image.vignette} alt="" class="mr-3 inline-block h-12 w-12 rounded object-cover align-middle" /> {image.nom}</li>
              ))}
            </ul>
          </section>
        )}
        <div data-ecran-publier data-empreinte={empreinte} data-etat={etat}>
          {etat === 'pas-abouti' && <Button type="button" id="bouton-relancer" class="mt-6 h-auto rounded-md px-4 py-2 max-md:min-h-11">{TEXTE_PUBLICATION_BOUTON_RELANCER}</Button>}
        </div>
        <p class="mt-6"><a id="annuler-publier" href={retour} class="inline-flex min-h-11 items-center rounded-md border border-line px-4 text-sm text-ink hover:bg-muted">{TEXTE_BOUTON_ANNULER_PUBLIER}</a></p>
      </>
    )
  }
  {
    rien && (
      <div data-ecran-publier data-empreinte={empreinte} data-etat={etat} data-rien>
        {etat === 'pas-abouti' && <Button type="button" id="bouton-relancer" class="mt-6 h-auto rounded-md px-4 py-2 max-md:min-h-11">{TEXTE_PUBLICATION_BOUTON_RELANCER}</Button>}
      </div>
    )
  }
  <MontageEcranPublier slot="scripts" />
</GabaritCadre>
