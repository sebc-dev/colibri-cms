---
/**
 * L'`Écran : Demandes` (change 013, ticket 03) : la liste des demandes, la plus récente
 * d'abord, 50 au plus. Rendu serveur, garde de session importée (ADR-0007), l'îlot
 * EcranDemandes (nombres, filtre, liste, retrait groupé, ticket 09) se monte sur la présentation
 * statique rendue ici, vidée au montage ; les données passent en `data-donnees`. Le titre et la
 * pagination restent rendus par le serveur, hors de l'îlot.
 * Texte de demande interpolé échappé seulement, jamais de `set:html` (I5).
 */
import GabaritCadre from '../../admin/GabaritCadre.astro';
import MontageEcranDemandes from '../../admin/MontageEcranDemandes.astro';
import { Badge } from '../../admin/composants/ui/badge/index.ts';
import { verifierSession } from '../../platform/session/index.ts';
import {
  listerDemandes,
  compterDemandes,
  listerFormulairesDeDemandes,
  compterParFormulaire,
} from '../../platform/demandes/magasin.ts';
import { composerNombres } from '../../core/demandes/nombres.ts';
import { formaterReception } from '../../core/demandes/date.ts';
import { bornerPage, choisirFormulaire, nombreDePages, nomDuFormulaire } from '../../core/demandes/liste.ts';
import { lireFormulairesDeLaDeclaration } from '../../platform/contenu/formulaires.ts';
import { formaterPrix } from '../../core/formulaires/prix.ts';
import {
  TEXTE_TITRE_DEMANDES,
  TEXTE_AUCUNE_DEMANDE,
  TEXTES_SUITE_DEMANDE,
  TEXTE_EMAIL_NON_PARTI,
  TEXTE_FILTRE_FORMULAIRE,
  TEXTE_FILTRE_TOUS,
  TEXTE_DEMANDES_PLUS_RECENTES,
  TEXTE_DEMANDES_PLUS_ANCIENNES,
  texteNumeroDePage,
  texteNombresDuSite,
  texteLibelleSuite,
  TEXTE_COLONNE_FORMULAIRE,
  TEXTE_COLONNE_DEMANDES,
  TEXTE_COLONNE_COMMANDES,
  TEXTE_COLONNE_RETIREES,
  TEXTE_NOMBRES_PAR_FORMULAIRE,
} from '../../admin/textes.ts';
import { env } from 'cloudflare:workers';

const session = await verifierSession(env.DB, Astro.request);
if (!session) {
  return Astro.redirect('/admin/connexion');
}

const declares = lireFormulairesDeLaDeclaration();
const presents = (await listerFormulairesDeDemandes(env.DB)).map((f) => ({
  id: f.id,
  nom: nomDuFormulaire(f.id, declares, [{ nom: f.nom, recueLe: 0 }]),
}));
const formulaire = choisirFormulaire(Astro.url.searchParams.get('formulaire'), presents);
const total = await compterDemandes(env.DB, formulaire);
const pages = nombreDePages(total);
const page = bornerPage(Astro.url.searchParams.get('page'), pages);
const demandes = await listerDemandes(env.DB, page, formulaire);

const nombres = composerNombres(await compterParFormulaire(env.DB), declares);

function adresse(f: string | null, p: number): string {
  const requete = new URLSearchParams();
  if (f !== null) requete.set('formulaire', f);
  if (p > 1) requete.set('page', String(p));
  const texte = requete.toString();
  return texte === '' ? '/admin/demandes' : `/admin/demandes?${texte}`;
}
const nomsParId = new Map(presents.map((f) => [f.id, f.nom]));

// Les lignes ne passent pas dans ce JSON : chacune porte ses propres données (`data-demande`),
// lues au montage ; la coordonnée n'y est pas redite, elle se lit dans le texte de la ligne (`data-contact`).
// `<` et `>` passent en échappements JSON : aucun balisage brut dans un attribut (I5).
const jsonSansChevrons = (valeur: unknown): string =>
  JSON.stringify(valeur).replaceAll('<', '\\u003c').replaceAll('>', '\\u003e');
const ligneJson = (d: (typeof demandes)[number]): string =>
  jsonSansChevrons({
    id: d.id,
    reception: formaterReception(d.recueLe),
    formulaire: nomsParId.get(d.formulaireId) ?? d.formulaireNom,
    page: d.pageTitre,
    prix: d.total !== null ? `${formaterPrix(d.total)} €` : null,
    suite: d.suite,
    libelle: texteLibelleSuite(formaterReception(d.recueLe)),
    courrielNonParti: d.courriel === 'non-parti',
  });
const donnees = jsonSansChevrons({
  nombres: {
    site: nombres.site,
    formulaires: nombres.formulaires.map((f) => ({
      id: f.id,
      nom: f.nom,
      demandes: f.demandes,
      commandes: f.commandes,
      retirees: f.retirees,
    })),
    montrerRetirees: nombres.montrerRetirees,
  },
  filtres: presents.map((f) => ({ id: f.id, nom: f.nom, adresse: adresse(f.id, 1) })),
  adresseTous: adresse(null, 1),
  formulaire,
});
---

<GabaritCadre titre="Demandes — Administration" rubrique="demandes">
  <h1>{TEXTE_TITRE_DEMANDES}</h1>
  <div class="max-md:has-[[data-barre-selection]]:pb-28">
  <div data-ecran-demandes data-donnees={donnees}>
  <p class="mt-4 font-medium" data-nombres-site>
    {texteNombresDuSite(nombres.site.demandes, nombres.site.commandes, nombres.site.retirees)}
  </p>
  {
    nombres.formulaires.length > 0 && (
      <table class="mt-4 w-full text-left" aria-label={TEXTE_NOMBRES_PAR_FORMULAIRE}>
        <thead>
          <tr>
            <th scope="col">{TEXTE_COLONNE_FORMULAIRE}</th>
            <th scope="col">{TEXTE_COLONNE_DEMANDES}</th>
            <th scope="col">{TEXTE_COLONNE_COMMANDES}</th>
            {nombres.montrerRetirees && <th scope="col">{TEXTE_COLONNE_RETIREES}</th>}
          </tr>
        </thead>
        <tbody>
          {nombres.formulaires.map((f) => (
            <tr data-nombres-formulaire={f.id}>
              <th scope="row" class="break-words font-normal">{f.nom}</th>
              <td data-nombre-demandes>{f.demandes}</td>
              <td data-nombre-commandes>{f.commandes}</td>
              {nombres.montrerRetirees && <td>{f.retirees}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  {
    presents.length > 0 && (
      <nav aria-label={TEXTE_FILTRE_FORMULAIRE} class="mt-6 flex flex-wrap items-center gap-2">
        <span>{TEXTE_FILTRE_FORMULAIRE}</span>
        <a href={adresse(null, 1)} aria-current={formulaire === null ? 'true' : undefined} class="min-h-11 underline md:min-h-0">
          {TEXTE_FILTRE_TOUS}
        </a>
        {presents.map((f) => (
          <a href={adresse(f.id, 1)} aria-current={formulaire === f.id ? 'true' : undefined} class="min-h-11 underline md:min-h-0">
            {f.nom}
          </a>
        ))}
      </nav>
    )
  }
  {
    demandes.length === 0 ? (
      <div class="mt-6 rounded-lg border border-border bg-card p-4 text-ink-muted">
        <p>{TEXTE_AUCUNE_DEMANDE}</p>
      </div>
    ) : (
      <ul class="mt-6 divide-y divide-border rounded-lg border border-border bg-card">
        {demandes.map((d) => (
          <li class="flex flex-col gap-1 px-4 py-3 md:flex-row md:items-center md:gap-4" data-demande={ligneJson(d)}>
            <a href={`/admin/demandes/${d.id}`} class="min-h-11 break-words font-medium md:min-h-0">
              {formaterReception(d.recueLe)}
            </a>
            <span class="break-words">{nomsParId.get(d.formulaireId) ?? d.formulaireNom}</span>
            <span class="break-words text-ink-muted">{d.pageTitre}</span>
            <span class="break-all" data-contact>{d.contact}</span>
            {d.total !== null && <span>{`${formaterPrix(d.total)} €`}</span>}
            <div>
              <span>{TEXTES_SUITE_DEMANDE[d.suite] ?? ''}</span>
            </div>
            {d.courriel === 'non-parti' && (
              <Badge variant="outline">{TEXTE_EMAIL_NON_PARTI}</Badge>
            )}
          </li>
        ))}
      </ul>
    )
  }
  </div>
  {
    pages > 1 && (
      <nav class="mt-6 flex flex-wrap items-center gap-4">
        {page > 1 && (
          <a href={adresse(formulaire, page - 1)} class="min-h-11 underline md:min-h-0">
            {TEXTE_DEMANDES_PLUS_RECENTES}
          </a>
        )}
        <span>{texteNumeroDePage(page, pages)}</span>
        {page < pages && (
          <a href={adresse(formulaire, page + 1)} class="min-h-11 underline md:min-h-0">
            {TEXTE_DEMANDES_PLUS_ANCIENNES}
          </a>
        )}
      </nav>
    )
  }
  </div>
  <MontageEcranDemandes slot="scripts" />
</GabaritCadre>
