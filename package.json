{
  "name": "colibri-cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/preparer-worker-de-test.mjs --avant",
    "build": "astro build",
    "postbuild": "node scripts/preparer-worker-de-test.mjs --apres",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run --passWithNoTests --dangerouslyIgnoreUnhandledErrors",
    "precoverage": "npm run build",
    "coverage": "vitest run --coverage --passWithNoTests --dangerouslyIgnoreUnhandledErrors",
    "lint": "eslint .",
    "lint:boundaries": "eslint --config eslint.config.boundaries.js .",
    "knip": "knip",
    "mutation": "stryker run",
    "dev": "astro dev",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/svelte": "^9.0.1",
    "@lucide/svelte": "^1.34.0",
    "astro": "^7.2.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "svelte": "^5.56.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "knip": "^6.32.0",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "fast-uri": "^3.1.6"
  }
}
