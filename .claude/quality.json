{
  "version": 1,
  "scope": { "changedOnly": true, "paths": ["src/**", "tests/**", "migrations/**"] },
  "applier": "quality-apply",
  "checks": [
    {
      "id": "typecheck",
      "cmd": "npm run typecheck",
      "severity": "blocking",
      "autofix": null
    },
    {
      "id": "lint",
      "cmd": "npm run lint",
      "severity": "blocking",
      "autofix": "npm run lint -- --fix"
    },
    {
      "id": "boundaries",
      "cmd": "npm run lint:boundaries",
      "severity": "blocking",
      "autofix": null,
      "agent": "quality-boundaries"
    },
    {
      "id": "test",
      "cmd": "npm test",
      "severity": "blocking",
      "autofix": null
    },
    {
      "id": "knip",
      "cmd": "npm run knip",
      "severity": "advisory",
      "autofix": null,
      "agent": "quality-knip"
    },
    {
      "id": "crap",
      "cmd": "npm run crap",
      "severity": "advisory",
      "threshold": { "metric": "crap", "max": 6 },
      "autofix": null,
      "agent": "quality-crap"
    },
    {
      "id": "mutation",
      "cmd": "npm run mutation:diff",
      "severity": "advisory",
      "autofix": null,
      "agent": "quality-mutation"
    }
  ]
}
