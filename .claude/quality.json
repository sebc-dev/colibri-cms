{
  "version": 1,
  "checks": [
    {
      "id": "typecheck",
      "cmd": "npm run typecheck",
      "severity": "blocking",
      "autofix": null
    },
    {
      "id": "lint",
      "cmd": "npm run lint",
      "severity": "blocking",
      "autofix": "npm run lint -- --fix"
    },
    {
      "id": "boundaries",
      "cmd": "npm run lint:boundaries",
      "severity": "blocking",
      "autofix": null
    },
    {
      "id": "build",
      "cmd": "npm run build",
      "severity": "advisory",
      "autofix": null
    },
    {
      "id": "test",
      "cmd": "npm test",
      "severity": "advisory",
      "autofix": null
    },
    {
      "id": "knip",
      "cmd": "npm run knip",
      "severity": "advisory",
      "autofix": null
    }
  ]
}
