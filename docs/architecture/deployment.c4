// Déploiement — où tourne quoi. Posé par /scd-spec-dev:archi-dossier (relevé).
// Le poste local et la recette ont une trace. L'environnement « production » décrit la cible décidée par l'ADR-0035 (change 020) :
// aucune instance de client n'est encore déployée.

specification {
  deploymentNode environment
  deploymentNode node
}

deployment {
  // trace : package.json:27 — "dev": "astro dev" (liaisons de wrangler.astro.jsonc) ; vitest.config.ts — tests dans workerd (ADR-0014)
  local = environment 'Poste local' {
    miniflare = node 'Miniflare (workerd)' {
      description 'astro dev et la suite de tests : liaisons D1 et send_email servies localement, rien ne part vers un compte.'
      instanceOf colibri-cms.worker
      instanceOf colibri-cms.d1
    }
  }

  // ADR-0036 : le serveur principal de recette est une instance aux noms du produit, bâtie par Workers Builds ; les aperçus
  // vivent sur un second Worker, propre à l'outillage. trace : .claude/skills/recette/SKILL.md — en-tête et § Première installation
  recette = environment 'Recette' {
    workers = node 'Cloudflare Workers — colibri-cms, colibri.sebc.dev' {
      description "Serveur principal : la configuration dérivée d'instance.json, déployée telle quelle. Adresse par défaut et adresses d'aperçu fermées, comme chez un client."
      instanceOf colibri-cms.worker
    }
    apercus = node 'Cloudflare Workers — colibri-recette, adresses d’aperçu' {
      description "Worker de l'outillage de recette, sans domaine : aperçus de branche et variantes du site factice. Aucun client n'en a."
      instanceOf colibri-cms.worker
    }
    base = node 'Cloudflare D1 — base colibri' {
      description 'Une seule base, lue par le serveur principal et par le Worker des aperçus.'
      instanceOf colibri-cms.d1
    }
  }

  // ADR-0035 : une instance par site, dans le compte Cloudflare du client. Le Worker s'appelle colibri-cms et la base colibri
  // dans chaque compte (ADR-0034) ; le domaine servi vient d'instance.json.
  production = environment 'Comptes du client' {
    cloudflare = node 'Compte Cloudflare du client' {
      description "Ouvert au nom du client, qui en est Super Administrateur ; palier gratuit, aucun moyen de paiement. L'intégrateur y est membre jusqu'à la livraison."
      workers = node 'Cloudflare Workers — domaine du client' {
        instanceOf colibri-cms.worker
      }
      base = node 'Cloudflare D1 — base colibri' {
        instanceOf colibri-cms.d1
      }
    }
  }
}

views {
  deployment view recette {
    title 'Déploiement — recette'
    include recette.**
  }

  deployment view production {
    title 'Déploiement — comptes du client'
    include production.**
  }

  deployment view local {
    title 'Déploiement — poste local'
    include local.**
  }
}
